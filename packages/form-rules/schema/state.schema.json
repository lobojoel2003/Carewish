{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lobojoel2003/Carewish/packages/form-rules/schema/state.schema.json",
  "title": "Carewish state advance directive rules",
  "description": "Form structure, witness rules and notary rules for one U.S. state's advance directive documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "adultAge", "terminology", "documents", "sources", "review"],
  "properties": {
    "$schema": { "type": "string" },
    "code": {
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
        "WA",
        "WV",
        "WI",
        "WY"
      ]
    },
    "name": { "type": "string", "minLength": 2 },
    "adultAge": { "type": "integer", "minimum": 18, "maximum": 21 },
    "terminology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {
          "enum": [
            "agent",
            "health-care-agent",
            "health-care-proxy",
            "health-care-surrogate",
            "health-care-representative",
            "patient-advocate",
            "representative"
          ]
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/localizedText" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation"],
        "properties": {
          "citation": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "lastChecked"],
      "properties": {
        "status": { "enum": ["needs-review", "reviewed"] },
        "lastChecked": { "type": "string", "format": "date" },
        "reviewer": { "type": "string" },
        "openQuestions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["en"],
          "propertyNames": { "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "attribute": {
      "enum": [
        "agent",
        "spouse",
        "immediate-family",
        "relative-within-third-degree",
        "blood-relative",
        "relative-by-marriage",
        "relative",
        "heir",
        "beneficiary",
        "creditor",
        "financially-responsible",
        "physician",
        "attending-physician",
        "healthcare-provider",
        "provider-employee",
        "facility-operator",
        "facility-employee",
        "insurer-employee",
        "signed-for-principal"
      ]
    },
    "section": {
      "enum": [
        "principal",
        "agent",
        "alternate-agent",
        "agent-authority",
        "life-sustaining",
        "nutrition",
        "cpr",
        "pain-relief",
        "values",
        "organ-donation",
        "physician",
        "additional-wishes"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "citation", "parts", "execution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["power-of-attorney", "living-will", "combined"] },
        "citation": { "type": "string", "minLength": 3 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "sections"],
            "properties": {
              "title": { "type": "string", "minLength": 2 },
              "sections": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/section" }
              }
            }
          }
        },
        "execution": { "$ref": "#/$defs/execution" },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "fields"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
            "fields": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "enum": [
            "witnesses",
            "notary",
            "witnesses-or-notary",
            "witnesses-and-notary",
            "signature-only"
          ]
        },
        "witnesses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "minAge", "rules"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 3 },
            "minAge": { "type": "integer", "minimum": 18, "maximum": 21 },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "attributes"],
                "properties": {
                  "type": { "enum": ["none-may-be", "at-least-one-not", "at-most-one"] },
                  "attributes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/attribute" }
                  },
                  "note": { "$ref": "#/$defs/localizedText" }
                }
              }
            }
          }
        },
        "notary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disqualified": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/attribute" }
            },
            "recommended": { "type": "boolean" },
            "note": { "$ref": "#/$defs/localizedText" }
          }
        },
        "special": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "text": { "$ref": "#/$defs/localizedText" }
            }
          }
        },
        "agentAcceptance": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": { "enum": ["witnesses", "witnesses-or-notary", "witnesses-and-notary"] }
            }
          },
          "then": { "required": ["witnesses"] }
        },
        {
          "if": { "properties": { "method": { "enum": ["notary", "signature-only"] } } },
          "then": { "not": { "required": ["witnesses"] } }
        }
      ]
    }
  }
}
