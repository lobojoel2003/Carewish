# Copy to apps/web/.env.local for local development.

# Optional: enables encrypted accounts and card links. Leave unset for local-only mode.
# DATABASE_URL=postgres://carewish:carewish@localhost:5432/carewish

# Required when DATABASE_URL is set (32+ characters). Generate: openssl rand -hex 32
# CAREWISH_SECRET=

# Optional: TLS to Postgres
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_SIZE=10

# Optional: public origin used in wallet-card QR codes (defaults to the browser's origin)
# NEXT_PUBLIC_SITE_URL=https://carewish.example.org

# Build metadata (CI sets these automatically)
# BUILD_NUMBER=
# COMMIT_SHA=
