    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "samples": "vitest run --config vitest.samples.config.ts"
  },
  "dependencies": {
    "@carewish/form-rules": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "i18next": "^27.1.5",
    "idb": "^8.0.3",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/fhir": "^0.0.44",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "@axe-core/playwright": "^4.14.0"
  }
