{
  "name": "@carewish/web",
  "version": "1.0.0",
  "private": true,
  "description": "Carewish web app: plain-language advance directive builder.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
